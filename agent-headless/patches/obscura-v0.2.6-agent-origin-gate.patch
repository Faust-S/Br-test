+/// Additional allow-origin gate for the IWXA agent's no-render worker.
+/// THIS IS NOT AN OPERATING-SYSTEM NETWORK SANDBOX.
+fn iwxa_origin_guard_allows(request: &Url, configured_origin: &str) -> bool {
+    let Ok(allowed) = Url::parse(configured_origin) else { return false };
+    allowed.scheme() == "https"
+        && !allowed.cannot_be_a_base()
+        && allowed.username().is_empty()
+        && allowed.password().is_none()
+        && allowed.port_or_known_default() == Some(443)
+        && allowed.path() == "/"
+        && allowed.query().is_none()
+        && allowed.fragment().is_none()
+        && request.scheme() == "https"
+        && request.origin() == allowed.origin()
+}
+
+#[cfg(test)]
+mod iwxa_agent_origin_guard_tests {
+    use super::*;
+
+    #[test]
+    fn permits_same_origin_pages() {
+        assert!(iwxa_origin_guard_allows(&Url::parse("https://example.org/a?q=1").unwrap(), "https://example.org"));
+        assert!(iwxa_origin_guard_allows(&Url::parse("https://example.org:443/").unwrap(), "https://example.org"));
+    }
+
+    #[test]
+    fn denies_different_origin_or_protocol() {
+        for value in ["https://other.org/", "https://sub.example.org/", "http://example.org/", "https://example.org:444/", "file:///tmp/a"] {
+            assert!(!iwxa_origin_guard_allows(&Url::parse(value).unwrap(), "https://example.org"));
+        }
+    }
+
+    #[test]
+    fn denies_invalid_configuration() {
+        let requested = Url::parse("https://example.org/").unwrap();
+        for value in ["", "http://example.org", "https://example.org/path", "https://user@example.org", "https://example.org:444", "https://example.org?x=1"] {
+            assert!(!iwxa_origin_guard_allows(&requested, value));
+        }
+    }
+}
