{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iwxa:u03:capability-status:1.0.0-proposal",
  "title": "IWXA U03 Capability Status proposal 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "available"
  ],
  "properties": {
    "schema": {
      "const": "IWXA_CAPABILITY_STATUS/1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*(?![\\s\\S])"
    },
    "available": {
      "type": "boolean"
    },
    "version": {
      "type": "string",
      "minLength": 5,
      "maxLength": 120,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
    },
    "reason": {
      "type": "string",
      "maxLength": 256
    },
    "observationRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "\\S"
    }
  }
}
