{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iwxa:u03:module-descriptor:1.0.0-proposal",
  "title": "IWXA U03 Module Descriptor proposal 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "provides", "requires", "hostCompatibility"],
  "properties": {
    "schema": {"const": "IWXA_MODULE_DESCRIPTOR/1.0.0"},
    "id": {"$ref": "#/$defs/identifier"},
    "version": {"$ref": "#/$defs/version"},
    "provides": {
      "type": "array", "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "version"],
        "properties": {"id": {"$ref": "#/$defs/identifier"}, "version": {"$ref": "#/$defs/version"}}
      }
    },
    "requires": {
      "type": "array", "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "range"],
        "properties": {"id": {"$ref": "#/$defs/identifier"}, "range": {"$ref": "#/$defs/range"}}
      }
    },
    "hostCompatibility": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["hostId", "range"],
        "properties": {"hostId": {"$ref": "#/$defs/identifier"}, "range": {"$ref": "#/$defs/range"}}
      }
    }
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
    "version": {"type": "string", "minLength": 5, "maxLength": 120, "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "range": {
      "type": "string", "minLength": 5, "maxLength": 240,
      "pattern": "^(?:(?:>=|<=|>|<|=)?(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*))(?: (?:(?:>=|<=|>|<|=)?(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*))){0,3}$"
    }
  }
}
