-#[op2(fast)]
-fn op_console_msg(
+// Site text is untrusted. Only the owned native UI returns a real Yes.
+#[op2(fast)]
+fn op_iwxa_confirm(#[string] prompt: &str) -> i32 {
+    // 1=Yes; 0=No or close; -1=no dialog available.
+    if prompt.len() > 4096 || prompt.contains('\0') { return -1; }
+    #[cfg(all(feature = "native-dialog", any(target_os = "linux", target_os = "windows")))]
+    {
+        if std::env::var("IWXA_OBSCURA_NATIVE_CONFIRM_UI").as_deref() != Ok("1") {
+            return -1;
+        }
+        return std::panic::catch_unwind(|| {
+            let answer = rfd::MessageDialog::new()
+                .set_title("IWXA Browser - Site confirmation")
+                .set_description(format!("This website requests confirmation:\n\n{prompt}"))
+                .set_buttons(rfd::MessageButtons::YesNo)
+                .set_level(rfd::MessageLevel::Info)
+                .show();
+            if answer == rfd::MessageDialogResult::Yes { 1 } else { 0 }
+        }).unwrap_or(-1);
+    }
+    #[cfg(not(all(feature = "native-dialog", any(target_os = "linux", target_os = "windows"))))]
+    { -1 }
+}
+
+#[op2(fast)]
+fn op_console_msg(
     state: &OpState,
     #[string] level: &str,
     #[string] msg: &str,
@@ -7825,7 +7849,8 @@
         op_cssom_stylesheet_update(),
         op_cssom_stylesheet_clear(),
         op_runtime_events_enabled(),
-        op_console_msg(),
