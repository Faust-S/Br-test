diff --git a/crates/obscura-js/js/bootstrap.js b/crates/obscura-js/js/bootstrap.js
--- a/crates/obscura-js/js/bootstrap.js
+++ b/crates/obscura-js/js/bootstrap.js
@@ -16935,12 +16935,19 @@
 globalThis.blur = function() {}; _markNative(globalThis.blur);
 globalThis.print = function() {}; _markNative(globalThis.print);
 globalThis.alert = function() {}; _markNative(globalThis.alert);
-// The headless engine cannot show a synchronous user confirmation yet.
-// Never silently authorize a save, transfer, deletion or other site action.
-globalThis.confirm = function() {
-  console.warn('Obscura window.confirm: native dialog unavailable; action declined');
-  return false;
-}; _markNative(globalThis.confirm);
+// Only the owner-enabled native OS dialog may grant the requested action.
+globalThis.confirm = function(message) {
+  try {
+    const op = __obscuraCore.ops.op_iwxa_confirm;
+    if (typeof op === 'function') {
+      const decision = op(String(message ?? ''));
+      if (decision === 1) return true;
+      if (decision === 0) return false;
+    }
+  } catch (_) {}
+  console.warn('Obscura window.confirm: native dialog unavailable; action declined');
+  return false;
+}; _markNative(globalThis.confirm);
 globalThis.prompt = function() { return null; }; _markNative(globalThis.prompt);
 globalThis.open = function() { return null; }; _markNative(globalThis.open);
 globalThis.close = function() {}; _markNative(globalThis.close);
